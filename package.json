{
  "name": "ben-que-market",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4000",
    "prebuild": "npm run encoding:check",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-db.ps1",
    "db:backup:now": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-db.ps1 -Label baseline",
    "db:restore:latest": "powershell -ExecutionPolicy Bypass -File ./scripts/restore-db.ps1",
    "db:restore:latest:to-neon": "powershell -ExecutionPolicy Bypass -File ./scripts/restore-latest-to-neon.ps1",
    "encoding:check": "node ./scripts/encoding-guard.mjs",
    "encoding:fix": "node ./scripts/encoding-guard.mjs --fix",
    "db:fill:last-month": "node ./scripts/fill-last-month-data.mjs",
    "db:clear:commerce": "node ./scripts/clear-commerce-data.mjs",
    "db:backfill:coupon-orders": "node ./scripts/backfill-coupon-orders.mjs",
    "db:sync:coupon-usedcount": "node ./scripts/sync-coupon-usedcount-from-orders.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.33.3",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^6.14.0",
    "@reduxjs/toolkit": "^2.8.2",
    "date-fns": "^4.1.0",
    "imagekit": "^6.0.0",
    "inngest": "^3.54.0",
    "lucide-react": "^0.525.0",
    "next": "^15.5.7",
    "openai": "^6.10.0",
    "quill": "^2.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-quill-new": "^3.8.3",
    "react-redux": "^9.2.0",
    "recharts": "^3.1.2",
    "stripe": "^20.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "19.2.7",
    "@types/ws": "^8.18.1",
    "prisma": "^6.14.0",
    "tailwindcss": "^4"
  }
}
